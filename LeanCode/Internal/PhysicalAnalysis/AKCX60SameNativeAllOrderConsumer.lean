local notation "fixedScale" => originalStartupScale length lengthPositive

/-- The fixed radial partition and one original B10 radius close every spatial order, signed
axial power and natural cell weight. No PDE, coefficient identity, output
moment or unknown regularity is imposed as an extra hypothesis. -/
theorem actualOriginalNative_allOrders
    (low : physicalBudget parameters state.val.val.field state.val.val.rho state.val.val.epsilon 10 <
      actualNativeAllOrderRadius parameters length compact lengthPositive state.val.val.compactNonnegative) :
    ∃ weighted : StartupAllMoments 3,
      (∀ᵐ point ∂volume.restrict openUnitDisk, ∀ cell : ℤ,
        weighted.field point cell = physicalWeight parameters.sigma0 parameters.gamma (fixedScale).val cell point •
          actualCartesianCovariantCell parameters length compact lengthPositive widthHalf widthLength state small source flat fields member sameSources allGrades cell ((fixedScale).val • point)) ∧
      ∀ order, ((StartupSignedFamily.ofNatural weighted length (fixedScale).val).circle).HasSpatialGrade order := by
  exact actualOriginalNative_B10_allSpatialGrades parameters length compact lengthPositive widthHalf widthLength state small source flat fields member sameSources allGrades compatible
    M Mnonnegative stateBound vanishing nativeBound graded sameGrade constants estimate
    actualNativeOuterCutoff actualNativeInsideCutoff actualNativeOuterCutoff_smooth actualNativeInsideCutoff_smooth
    actualNativeOuterCutoff_compact actualNativeInsideCutoff_compact actualNativeOuterCutoff_inside
    actualNativeCutoff_plateau actualNativeInsideCutoff_radial low
    actualNativeAnnularCutoff actualNativeAnnularCutoff_smooth actualNativeAnnularCutoff_compact
    actualNativeAnnularCutoff_radial actualNativeCutoff_partition (actualNativeAnnularCutoff_punctured length lengthPositive)

