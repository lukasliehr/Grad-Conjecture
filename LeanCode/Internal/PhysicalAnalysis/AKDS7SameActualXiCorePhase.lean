/-- Exact original Xi core phase at the undilated whole disk, including
all original axial cells. This identifies the scalar in the actual weak rows. -/
theorem actualNativeXi_core_phase
    (scalar : ACore parameters 1)
    (same : ∀ (point : ClosedDisk),0<‖point.val‖ → ∀ axial : ℝ,
      (originalPhysicalClosedJet parameters scalar).value (point,(axial : CellCircle))=
        actualCartesianXiFamilyField parameters length compact lengthPositive widthHalf widthLength state small
          source flat fields member sameSources allGrades (point.val,axial))
    (xi : StartupL2 1)
    (xiSame : ∀ᵐ point ∂volume.restrict openUnitDisk, ∀ cell : ℤ,
      xi point cell = actualCartesianXiCell parameters length compact lengthPositive widthHalf widthLength
        state small source flat fields member sameSources allGrades cell point) :
    StartupRadialRelated (physicalWeight parameters.sigma0 parameters.gamma 1)
      (originalSourceFieldLinear parameters scalar) xi := by
  have represented := originalCore_sameWeightedRep parameters scalar
    (fun pair => actualCartesianXiFamilyField parameters length compact lengthPositive widthHalf widthLength
      state small source flat fields member sameSources allGrades (pair.2,pair.1)) same
  filter_upwards [represented,xiSame,startupDisk_ae_nonzero,
    ae_restrict_mem openUnitDisk_isOpen.measurableSet] with point coreAt rawAt nonzero inside
  intro cell
  change (originalSourceMoments parameters scalar).field point cell = _
  rw [coreAt cell,rawAt cell,
    actualCartesianXiCell_actual parameters length compact lengthPositive widthHalf widthLength state small
      source flat fields member sameSources allGrades compatible cell point nonzero inside]

end Grad.ActualScaledNativeCoefficients
